<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
    id="Definitions_LoanApproval"
    targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="loan-approval-process" name="Loan Approval Process"
                isExecutable="true" camunda:historyTimeToLive="30">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  START                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <bpmn:startEvent id="StartEvent" name="Loan Requested">
      <bpmn:outgoing>flow_start_check</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  STEP 1 — Check Existing Contract                              -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <bpmn:serviceTask id="CheckExistingContract" name="Check Existing Contract"
                      camunda:delegateExpression="${checkExistingContractDelegate}">
      <bpmn:incoming>flow_start_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_gw</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="ContractExistsGW" name="Contract Exists?">
      <bpmn:incoming>flow_check_gw</bpmn:incoming>
      <bpmn:outgoing>flow_contract_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_contract_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Contract already exists → reject immediately -->
    <bpmn:serviceTask id="RejectDuplicate" name="Publish Loan Rejected (Duplicate)"
                      camunda:delegateExpression="${publishRejectedDelegate}">
      <bpmn:incoming>flow_contract_yes</bpmn:incoming>
      <bpmn:outgoing>flow_end_dup</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  STEP 2 — Check Score                                          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <bpmn:serviceTask id="CheckScore" name="Check Credit Score"
                      camunda:delegateExpression="${checkScoreDelegate}">
      <bpmn:incoming>flow_contract_no</bpmn:incoming>
      <bpmn:outgoing>flow_score_gw</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="ScoreGW" name="Score ≥ 400?">
      <bpmn:incoming>flow_score_gw</bpmn:incoming>
      <bpmn:outgoing>flow_score_ok</bpmn:outgoing>
      <bpmn:outgoing>flow_score_low</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  PATH A — Auto Approve (score ≥ 400)                           -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <bpmn:serviceTask id="CreateContractAuto" name="Create Contract (Auto)"
                      camunda:delegateExpression="${createContractDelegate}">
      <bpmn:incoming>flow_score_ok</bpmn:incoming>
      <bpmn:outgoing>flow_auto_approve</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="PublishApprovedAuto" name="Publish Loan Approved (Auto)"
                      camunda:delegateExpression="${publishApprovedDelegate}">
      <bpmn:incoming>flow_auto_approve</bpmn:incoming>
      <bpmn:outgoing>flow_end_auto</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  PATH B — Manager Decision (score < 400)                       -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <bpmn:userTask id="ManagerDecision" name="Manager Decision"
                   camunda:candidateGroups="managers">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="approved" label="Approve loan?" type="boolean" defaultValue="false"/>
          <camunda:formField id="rejectionReason" label="Rejection reason (if denied)" type="string"/>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_score_low</bpmn:incoming>
      <bpmn:outgoing>flow_mgr_gw</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ManagerGW" name="Manager approved?">
      <bpmn:incoming>flow_mgr_gw</bpmn:incoming>
      <bpmn:outgoing>flow_mgr_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_mgr_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="CreateContractMgr" name="Create Contract (Manager)"
                      camunda:delegateExpression="${createContractDelegate}">
      <bpmn:incoming>flow_mgr_yes</bpmn:incoming>
      <bpmn:outgoing>flow_mgr_approve</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="PublishApprovedMgr" name="Publish Loan Approved (Manager)"
                      camunda:delegateExpression="${publishApprovedDelegate}">
      <bpmn:incoming>flow_mgr_approve</bpmn:incoming>
      <bpmn:outgoing>flow_end_mgr_ok</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="RejectByManager" name="Publish Loan Rejected (Manager)"
                      camunda:delegateExpression="${publishRejectedDelegate}">
      <bpmn:incoming>flow_mgr_no</bpmn:incoming>
      <bpmn:outgoing>flow_end_mgr_rej</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  END EVENTS                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <bpmn:endEvent id="EndDuplicate"  name="Rejected (Duplicate)">
      <bpmn:incoming>flow_end_dup</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndAutoApproved" name="Approved (Auto)">
      <bpmn:incoming>flow_end_auto</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndMgrApproved" name="Approved (Manager)">
      <bpmn:incoming>flow_end_mgr_ok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndMgrRejected" name="Rejected (Manager)">
      <bpmn:incoming>flow_end_mgr_rej</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  SEQUENCE FLOWS                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <bpmn:sequenceFlow id="flow_start_check"   sourceRef="StartEvent"          targetRef="CheckExistingContract"/>
    <bpmn:sequenceFlow id="flow_check_gw"      sourceRef="CheckExistingContract" targetRef="ContractExistsGW"/>

    <bpmn:sequenceFlow id="flow_contract_yes" name="Yes (has contract)"
                       sourceRef="ContractExistsGW" targetRef="RejectDuplicate">
      <bpmn:conditionExpression>${contractExists == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_contract_no" name="No (no contract)"
                       sourceRef="ContractExistsGW" targetRef="CheckScore">
      <bpmn:conditionExpression>${contractExists == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_score_gw"    sourceRef="CheckScore"   targetRef="ScoreGW"/>

    <bpmn:sequenceFlow id="flow_score_ok" name="Score ≥ 400"
                       sourceRef="ScoreGW" targetRef="CreateContractAuto">
      <bpmn:conditionExpression>${score >= 400}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_score_low" name="Score &lt; 400"
                       sourceRef="ScoreGW" targetRef="ManagerDecision">
      <bpmn:conditionExpression>${score &lt; 400}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_auto_approve" sourceRef="CreateContractAuto"  targetRef="PublishApprovedAuto"/>
    <bpmn:sequenceFlow id="flow_mgr_gw"       sourceRef="ManagerDecision"     targetRef="ManagerGW"/>

    <bpmn:sequenceFlow id="flow_mgr_yes" name="Approved"
                       sourceRef="ManagerGW" targetRef="CreateContractMgr">
      <bpmn:conditionExpression>${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_mgr_no" name="Rejected"
                       sourceRef="ManagerGW" targetRef="RejectByManager">
      <bpmn:conditionExpression>${approved == false || approved == null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_mgr_approve" sourceRef="CreateContractMgr"   targetRef="PublishApprovedMgr"/>

    <bpmn:sequenceFlow id="flow_end_dup"     sourceRef="RejectDuplicate"      targetRef="EndDuplicate"/>
    <bpmn:sequenceFlow id="flow_end_auto"    sourceRef="PublishApprovedAuto"  targetRef="EndAutoApproved"/>
    <bpmn:sequenceFlow id="flow_end_mgr_ok"  sourceRef="PublishApprovedMgr"   targetRef="EndMgrApproved"/>
    <bpmn:sequenceFlow id="flow_end_mgr_rej" sourceRef="RejectByManager"      targetRef="EndMgrRejected"/>
  </bpmn:process>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!--  DIAGRAM (layout)                                                   -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="loan-approval-process">

      <bpmndi:BPMNShape id="shape_StartEvent"           bpmnElement="StartEvent"><dc:Bounds x="152" y="232" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_CheckExistingContract" bpmnElement="CheckExistingContract"><dc:Bounds x="240" y="210" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_ContractExistsGW"     bpmnElement="ContractExistsGW" isMarkerVisible="true"><dc:Bounds x="415" y="225" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_RejectDuplicate"      bpmnElement="RejectDuplicate"><dc:Bounds x="520" y="130" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_CheckScore"           bpmnElement="CheckScore"><dc:Bounds x="520" y="210" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_ScoreGW"              bpmnElement="ScoreGW" isMarkerVisible="true"><dc:Bounds x="695" y="225" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_CreateContractAuto"   bpmnElement="CreateContractAuto"><dc:Bounds x="800" y="210" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_PublishApprovedAuto"  bpmnElement="PublishApprovedAuto"><dc:Bounds x="980" y="210" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_ManagerDecision"      bpmnElement="ManagerDecision"><dc:Bounds x="800" y="340" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_ManagerGW"            bpmnElement="ManagerGW" isMarkerVisible="true"><dc:Bounds x="975" y="355" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_CreateContractMgr"    bpmnElement="CreateContractMgr"><dc:Bounds x="1080" y="340" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_PublishApprovedMgr"   bpmnElement="PublishApprovedMgr"><dc:Bounds x="1260" y="340" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_RejectByManager"      bpmnElement="RejectByManager"><dc:Bounds x="1080" y="460" width="120" height="80"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_EndDuplicate"   bpmnElement="EndDuplicate"><dc:Bounds x="712" y="132" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_EndAutoApproved" bpmnElement="EndAutoApproved"><dc:Bounds x="1162" y="232" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_EndMgrApproved" bpmnElement="EndMgrApproved"><dc:Bounds x="1442" y="362" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_EndMgrRejected" bpmnElement="EndMgrRejected"><dc:Bounds x="1262" y="482" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="edge_start_check"    bpmnElement="flow_start_check"><di:waypoint x="188" y="250"/><di:waypoint x="240" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_check_gw"       bpmnElement="flow_check_gw"><di:waypoint x="360" y="250"/><di:waypoint x="415" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_contract_yes"   bpmnElement="flow_contract_yes"><di:waypoint x="440" y="225"/><di:waypoint x="440" y="170"/><di:waypoint x="520" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_contract_no"    bpmnElement="flow_contract_no"><di:waypoint x="465" y="250"/><di:waypoint x="520" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_score_gw"       bpmnElement="flow_score_gw"><di:waypoint x="640" y="250"/><di:waypoint x="695" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_score_ok"       bpmnElement="flow_score_ok"><di:waypoint x="745" y="250"/><di:waypoint x="800" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_score_low"      bpmnElement="flow_score_low"><di:waypoint x="720" y="275"/><di:waypoint x="720" y="380"/><di:waypoint x="800" y="380"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_auto_approve"   bpmnElement="flow_auto_approve"><di:waypoint x="920" y="250"/><di:waypoint x="980" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_mgr_gw"         bpmnElement="flow_mgr_gw"><di:waypoint x="920" y="380"/><di:waypoint x="975" y="380"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_mgr_yes"        bpmnElement="flow_mgr_yes"><di:waypoint x="1025" y="380"/><di:waypoint x="1080" y="380"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_mgr_no"         bpmnElement="flow_mgr_no"><di:waypoint x="1000" y="405"/><di:waypoint x="1000" y="500"/><di:waypoint x="1080" y="500"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_mgr_approve"    bpmnElement="flow_mgr_approve"><di:waypoint x="1200" y="380"/><di:waypoint x="1260" y="380"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_end_dup"        bpmnElement="flow_end_dup"><di:waypoint x="640" y="170"/><di:waypoint x="712" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_end_auto"       bpmnElement="flow_end_auto"><di:waypoint x="1100" y="250"/><di:waypoint x="1162" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_end_mgr_ok"     bpmnElement="flow_end_mgr_ok"><di:waypoint x="1380" y="380"/><di:waypoint x="1442" y="380"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_end_mgr_rej"    bpmnElement="flow_end_mgr_rej"><di:waypoint x="1200" y="500"/><di:waypoint x="1262" y="500"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
