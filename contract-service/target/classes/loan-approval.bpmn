<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_LoanApproval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0">
  <bpmn:process id="loan-approval-process" name="Loan Approval Process" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:serviceTask id="CheckExistingContract" name="Check Existing Contract" camunda:delegateExpression="${checkExistingContractDelegate}">
      <bpmn:incoming>flow_start_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ContractExistsGW" name="Contract Exists?">
      <bpmn:incoming>flow_check_gw</bpmn:incoming>
      <bpmn:outgoing>flow_contract_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_contract_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="RejectDuplicate" name="Publish Loan Rejected (Duplicate)" camunda:delegateExpression="${publishRejectedDelegate}">
      <bpmn:incoming>flow_contract_yes</bpmn:incoming>
      <bpmn:outgoing>flow_end_dup</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CheckScore" name="Check Credit Score" camunda:delegateExpression="${checkScoreDelegate}">
      <bpmn:incoming>flow_contract_no</bpmn:incoming>
      <bpmn:outgoing>flow_score_gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ScoreGW" name="Score ≥ 400?">
      <bpmn:incoming>flow_score_gw</bpmn:incoming>
      <bpmn:outgoing>flow_score_ok</bpmn:outgoing>
      <bpmn:outgoing>flow_score_low</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CreateContractAuto" name="Create Contract (Auto)" camunda:delegateExpression="${createContractDelegate}">
      <bpmn:incoming>flow_score_ok</bpmn:incoming>
      <bpmn:outgoing>flow_auto_approve</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PublishApprovedAuto" name="Publish Loan Approved (Auto)" camunda:delegateExpression="${publishApprovedDelegate}">
      <bpmn:incoming>flow_auto_approve</bpmn:incoming>
      <bpmn:outgoing>flow_end_auto</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ManagerDecision" name="Manager Decision" camunda:candidateGroups="managers">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="approved" label="Approve loan?" type="boolean" defaultValue="false" />
          <camunda:formField id="rejectionReason" label="Rejection reason (if denied)" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_score_low</bpmn:incoming>
      <bpmn:outgoing>flow_mgr_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ManagerGW" name="Manager approved?">
      <bpmn:incoming>flow_mgr_gw</bpmn:incoming>
      <bpmn:outgoing>flow_mgr_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_mgr_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CreateContractMgr" name="Create Contract (Manager)" camunda:delegateExpression="${createContractDelegate}">
      <bpmn:incoming>flow_mgr_yes</bpmn:incoming>
      <bpmn:outgoing>flow_mgr_approve</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PublishApprovedMgr" name="Publish Loan Approved (Manager)" camunda:delegateExpression="${publishApprovedDelegate}">
      <bpmn:incoming>flow_mgr_approve</bpmn:incoming>
      <bpmn:outgoing>flow_end_mgr_ok</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="RejectByManager" name="Publish Loan Rejected (Manager)" camunda:delegateExpression="${publishRejectedDelegate}">
      <bpmn:incoming>flow_mgr_no</bpmn:incoming>
      <bpmn:outgoing>flow_end_mgr_rej</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndDuplicate" name="Rejected (Duplicate)">
      <bpmn:incoming>flow_end_dup</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndAutoApproved" name="Approved (Auto)">
      <bpmn:incoming>flow_end_auto</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndMgrApproved" name="Approved (Manager)">
      <bpmn:incoming>flow_end_mgr_ok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndMgrRejected" name="Rejected (Manager)">
      <bpmn:incoming>flow_end_mgr_rej</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_check" sourceRef="StartEvent" targetRef="CheckExistingContract" />
    <bpmn:sequenceFlow id="flow_check_gw" sourceRef="CheckExistingContract" targetRef="ContractExistsGW" />
    <bpmn:sequenceFlow id="flow_contract_yes" name="Yes (has contract)" sourceRef="ContractExistsGW" targetRef="RejectDuplicate">
      <bpmn:conditionExpression>${contractExists == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_contract_no" name="No (no contract)" sourceRef="ContractExistsGW" targetRef="CheckScore">
      <bpmn:conditionExpression>${contractExists == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_score_gw" sourceRef="CheckScore" targetRef="ScoreGW" />
    <bpmn:sequenceFlow id="flow_score_ok" name="Score ≥ 400" sourceRef="ScoreGW" targetRef="CreateContractAuto">
      <bpmn:conditionExpression>${score &gt;= 400}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_score_low" name="Score &#60; 400" sourceRef="ScoreGW" targetRef="ManagerDecision">
      <bpmn:conditionExpression>${score &lt; 400}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_auto_approve" sourceRef="CreateContractAuto" targetRef="PublishApprovedAuto" />
    <bpmn:sequenceFlow id="flow_mgr_gw" sourceRef="ManagerDecision" targetRef="ManagerGW" />
    <bpmn:sequenceFlow id="flow_mgr_yes" name="Approved" sourceRef="ManagerGW" targetRef="CreateContractMgr">
      <bpmn:conditionExpression>${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_mgr_no" name="Rejected" sourceRef="ManagerGW" targetRef="RejectByManager">
      <bpmn:conditionExpression>${approved == false || approved == null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_mgr_approve" sourceRef="CreateContractMgr" targetRef="PublishApprovedMgr" />
    <bpmn:sequenceFlow id="flow_end_dup" sourceRef="RejectDuplicate" targetRef="EndDuplicate" />
    <bpmn:sequenceFlow id="flow_end_auto" sourceRef="PublishApprovedAuto" targetRef="EndAutoApproved" />
    <bpmn:sequenceFlow id="flow_end_mgr_ok" sourceRef="PublishApprovedMgr" targetRef="EndMgrApproved" />
    <bpmn:sequenceFlow id="flow_end_mgr_rej" sourceRef="RejectByManager" targetRef="EndMgrRejected" />
    <bpmn:startEvent id="StartEvent" name="Loan Requested">
      <bpmn:outgoing>flow_start_check</bpmn:outgoing>
    </bpmn:startEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="loan-approval-process">
      <bpmndi:BPMNShape id="shape_StartEvent" bpmnElement="StartEvent">
        <dc:Bounds x="152" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="130" y="318" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_CheckExistingContract" bpmnElement="CheckExistingContract">
        <dc:Bounds x="240" y="260" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_ContractExistsGW" bpmnElement="ContractExistsGW" isMarkerVisible="true">
        <dc:Bounds x="415" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="474.5" y="293" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_CreateContractMgr" bpmnElement="CreateContractMgr">
        <dc:Bounds x="1080" y="390" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_PublishApprovedMgr" bpmnElement="PublishApprovedMgr">
        <dc:Bounds x="1260" y="390" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_EndMgrApproved" bpmnElement="EndMgrApproved">
        <dc:Bounds x="1442" y="412" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1434" y="448" width="52" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_CheckScore" bpmnElement="CheckScore">
        <dc:Bounds x="480" y="440" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_RejectDuplicate" bpmnElement="RejectDuplicate">
        <dc:Bounds x="490" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_EndDuplicate" bpmnElement="EndDuplicate">
        <dc:Bounds x="752" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="743" y="138" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_ScoreGW" bpmnElement="ScoreGW" isMarkerVisible="true">
        <dc:Bounds x="705" y="455" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="765" y="473" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_ManagerDecision" bpmnElement="ManagerDecision">
        <dc:Bounds x="780" y="610" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_CreateContractAuto" bpmnElement="CreateContractAuto">
        <dc:Bounds x="790" y="220" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_PublishApprovedAuto" bpmnElement="PublishApprovedAuto">
        <dc:Bounds x="980" y="220" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_EndAutoApproved" bpmnElement="EndAutoApproved">
        <dc:Bounds x="1162" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1140" y="278" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_ManagerGW" bpmnElement="ManagerGW" isMarkerVisible="true">
        <dc:Bounds x="995" y="625" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1055" y="636" width="52" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_RejectByManager" bpmnElement="RejectByManager">
        <dc:Bounds x="1080" y="770" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_EndMgrRejected" bpmnElement="EndMgrRejected">
        <dc:Bounds x="1292" y="792" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1284" y="828" width="52" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_start_check" bpmnElement="flow_start_check">
        <di:waypoint x="188" y="300" />
        <di:waypoint x="240" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_check_gw" bpmnElement="flow_check_gw">
        <di:waypoint x="360" y="300" />
        <di:waypoint x="415" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_contract_yes" bpmnElement="flow_contract_yes">
        <di:waypoint x="440" y="275" />
        <di:waypoint x="440" y="120" />
        <di:waypoint x="490" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="411" y="183" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_contract_no" bpmnElement="flow_contract_no">
        <di:waypoint x="440" y="325" />
        <di:waypoint x="440" y="480" />
        <di:waypoint x="480" y="480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="360" y="423" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_mgr_yes" bpmnElement="flow_mgr_yes">
        <di:waypoint x="1020" y="625" />
        <di:waypoint x="1020" y="430" />
        <di:waypoint x="1080" y="430" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="966" y="519" width="47" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_mgr_approve" bpmnElement="flow_mgr_approve">
        <di:waypoint x="1200" y="430" />
        <di:waypoint x="1260" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_end_mgr_ok" bpmnElement="flow_end_mgr_ok">
        <di:waypoint x="1380" y="430" />
        <di:waypoint x="1442" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_score_gw" bpmnElement="flow_score_gw">
        <di:waypoint x="600" y="480" />
        <di:waypoint x="705" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_end_dup" bpmnElement="flow_end_dup">
        <di:waypoint x="610" y="120" />
        <di:waypoint x="752" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_score_ok" bpmnElement="flow_score_ok">
        <di:waypoint x="730" y="455" />
        <di:waypoint x="730" y="260" />
        <di:waypoint x="790" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="670" y="349" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_score_low" bpmnElement="flow_score_low">
        <di:waypoint x="730" y="505" />
        <di:waypoint x="730" y="650" />
        <di:waypoint x="780" y="650" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="740" y="563" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_mgr_gw" bpmnElement="flow_mgr_gw">
        <di:waypoint x="900" y="650" />
        <di:waypoint x="995" y="650" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_auto_approve" bpmnElement="flow_auto_approve">
        <di:waypoint x="910" y="260" />
        <di:waypoint x="980" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_end_auto" bpmnElement="flow_end_auto">
        <di:waypoint x="1100" y="260" />
        <di:waypoint x="1162" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_mgr_no" bpmnElement="flow_mgr_no">
        <di:waypoint x="1020" y="675" />
        <di:waypoint x="1020" y="810" />
        <di:waypoint x="1080" y="810" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="968" y="733" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_end_mgr_rej" bpmnElement="flow_end_mgr_rej">
        <di:waypoint x="1200" y="810" />
        <di:waypoint x="1292" y="810" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
